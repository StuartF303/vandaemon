# Copy to app/keystore.properties (gitignored) to enable release signing for the AAB.
# Generate an upload keystore (once), then fill these in:
#
#   keytool -genkeypair -v -keystore vandaemon-upload.jks -alias vandaemon-upload \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# With Play App Signing (recommended), THIS is only the *upload* key — Google holds the app
# signing key. Keep vandaemon-upload.jks and this file OUT of git and backed up safely.
storeFile=vandaemon-upload.jks
storePassword=CHANGE_ME
keyAlias=vandaemon-upload
keyPassword=CHANGE_ME
